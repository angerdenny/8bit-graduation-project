# ===== 데이터베이스 =====
DATABASE_URL=mysql+pymysql://root:여기에_DB비밀번호@127.0.0.1:3306/netmon

# ===== 인증 (python -c "import secrets; print(secrets.token_hex(32))" 로 직접 생성) =====
JWT_SECRET=여기에_생성한_값
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ===== 에이전트 / 수집기 =====
AGENT_API_KEY=여기에_생성한_값
BACKEND_URL=http://127.0.0.1:8000
COLLECT_DEVICE_NAME=내PC이름
COLLECT_INTERVAL_SEC=5
PING_TARGET=8.8.8.8

# ===== 로그 =====
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

#-------JWT_SECRET과 AGENT_API_KEY는 반드시 python -c "import secrets; print(secrets.token_hex(32))"로 직접 만드세요